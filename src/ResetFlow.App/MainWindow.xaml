<Window x:Class="ResetFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ResetFlow" Height="760" Width="1180" MinHeight="620" MinWidth="980"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,7" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <DockPanel Background="#F6F7F9">
        <Border DockPanel.Dock="Top" Background="#1F2937" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ResetFlow" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                    <WrapPanel Margin="0,10,0,0">
                        <TextBlock Foreground="#D1D5DB" Text="{Binding WindowsVersion}" Margin="0,0,18,0" />
                        <TextBlock Foreground="#D1D5DB" Text="{Binding AdminStatus}" Margin="0,0,18,0" />
                        <TextBlock Foreground="#D1D5DB" Text="{Binding DeviceType}" Margin="0,0,18,0" />
                        <TextBlock Foreground="#D1D5DB" Text="{Binding GpuInfo}" />
                    </WrapPanel>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding RestartElevatedCommand}" Content="Restart elevated" />
            </Grid>
        </Border>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="160" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Categories" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Padding="4" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Margin="12,0,0,0">
                <DataGrid ItemsSource="{Binding Features}" SelectedItem="{Binding SelectedFeature}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="On" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="54" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="110" />
                        <DataGridTextColumn Header="Feature" Binding="{Binding Name}" IsReadOnly="True" Width="190" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" IsReadOnly="True" Width="130" />
                        <DataGridTextColumn Header="Automation" Binding="{Binding AutomationLevel}" IsReadOnly="True" Width="120" />
                        <DataGridTextColumn Header="Admin" Binding="{Binding RequiresAdmin}" IsReadOnly="True" Width="70" />
                        <DataGridTextColumn Header="Reboot" Binding="{Binding RequiresReboot}" IsReadOnly="True" Width="75" />
                        <DataGridTextColumn Header="Rollback" Binding="{Binding RollbackCapability}" IsReadOnly="True" Width="95" />
                        <DataGridTextColumn Header="Laptop skip" Binding="{Binding ExcludeOnLaptop}" IsReadOnly="True" Width="90" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" IsReadOnly="True" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Row="1" Grid.ColumnSpan="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,12,0,12" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0">
                        <Button Command="{Binding SelectAllCommand}" Content="All On" />
                        <Button Command="{Binding SelectNoneCommand}" Content="All Off" />
                        <Button Command="{Binding SelectCategoryCommand}" Content="Category On" />
                        <Button Command="{Binding ClearCategoryCommand}" Content="Category Off" />
                        <Button Command="{Binding StartCommand}" Content="Start" FontWeight="SemiBold" />
                        <Button Command="{Binding OpenLogCommand}" Content="Open log" />
                        <Button Command="{Binding OpenProfileCommand}" Content="Open profile" />
                    </WrapPanel>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ProgressBar Height="16" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" />
                            <TextBlock Text="{Binding CurrentFeature}" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding SummaryText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="Success " FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SuccessCount}" Margin="0,0,12,0" />
                            <TextBlock Text="Failed " FontWeight="SemiBold" />
                            <TextBlock Text="{Binding FailedCount}" Margin="0,0,12,0" />
                            <TextBlock Text="Skipped " FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SkippedCount}" />
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#111827" BorderBrush="#374151" BorderThickness="1" Padding="10">
                <ListBox ItemsSource="{Binding LogLines}" Background="#111827" Foreground="#D1D5DB" BorderThickness="0" FontFamily="Consolas" FontSize="12" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
